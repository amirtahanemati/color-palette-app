{
  "name": "color-palette-extractor",
  "version": "1.3.5",
  "author": "Taha Nemati",
  "description": "Color Palette Extractor Desktop App",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron-dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dist:win": "node scripts/build-win.js",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:linux": "vite build && electron-builder --linux",
    "dist": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.colorpalette.app",
    "productName": "Color Palette Extractor",
    "forceCodeSigning": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/assets/icon.ico",
      "signtoolOptions": {},
      "extraResources": [
        {
          "from": "../backend/dist/backend",
          "to": "backend",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "electron/assets/icon.icns",
      "extraResources": [
        {
          "from": "../backend/dist/backend",
          "to": "backend",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/assets/icon.png",
      "extraResources": [
        {
          "from": "../backend/dist/backend",
          "to": "backend",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "electron/assets/icon.ico",
      "uninstallerIcon": "electron/assets/icon.ico"
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "dotenv": "^17.4.2",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "terser": "^5.48.0",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  }
}
